# Generated by vibraphone init_project
# https://github.com/lukemcguire/vibraphone

project:
  name: {{ project_name }}
  version: 0.1.0

{% if components %}
components:
{% for name, config in components.items() %}
  {{ name }}:
    language: {{ config.language | default("python") }}
    root: {{ config.root | default("./") }}
    test_command: {{ config.test_command | default("pytest") }}
    lint_command: {{ config.lint_command | default("ruff check .") }}
    format_command: {{ config.format_command | default("ruff format .") }}
    coverage_threshold: {{ config.coverage_threshold | default(80) }}
{% endfor %}
{% endif %}

quality_gate:
  require_tests: true
  require_lint: true
  require_review: true
  review_severity_threshold: error
  max_test_attempts: 10
  max_review_attempts: 5

worktree:
  base_branch: main
  prefix: feat/
  auto_cleanup: false
{% if worktrees_path %}
  path: {{ worktrees_path }}
{% endif %}

review:
  model: {{ review_model | default("anthropic/claude-3-sonnet") }}
  prompt_file: ./docs/prompts/reviewer.md
  constitution_file: ./docs/CONSTITUTION.md

beads:
  use_bv: false
  auto_sync: true

stitch:
  enabled: false
  project_id: ${STITCH_PROJECT_ID}
